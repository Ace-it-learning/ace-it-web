{
    "firestore": {
        "rules": "firebase/firestore.rules"
    },
    "hosting": {
        "public": "frontend/dist",
        "ignore": [
            "firebase.json",
            "**/.*",
            "**/node_modules/**"
        ],
        "rewrites": [
            {
                "source": "/api/**",
                "run": {
                    "serviceId": "ace-it-backend",
                    "region": "asia-east2"
                }
            },
            {
                "source": "**",
                "destination": "/index.html"
            }
        ]
    }
}