{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Skill Map V2",
    "description": "Enhanced skill map structure for tracking student progress with granular micro-skills.",
    "type": "object",
    "properties": {
        "uid": {
            "type": "string",
            "description": "User ID"
        },
        "version": {
            "type": "integer",
            "const": 2,
            "description": "Schema version number"
        },
        "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "When this skill map was generated or last updated"
        },
        "diagnostic_timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "When the initial diagnostic was taken"
        },
        "overall_level": {
            "type": "number",
            "minimum": 1,
            "maximum": 5.5,
            "description": "Calculated overall DSE level (avg)"
        },
        "archetype": {
            "type": "string",
            "description": "Persona assignment based on strengths/weaknesses"
        },
        "microSkills": {
            "type": "object",
            "description": "Detailed breakdown of 47 micro-skills across 4 papers",
            "patternProperties": {
                "^(reading|writing|listening|speaking)_[a-zA-Z]+$": {
                    "type": "object",
                    "properties": {
                        "level": {
                            "type": "number",
                            "minimum": 1,
                            "maximum": 7
                        },
                        "confidence": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                        },
                        "evidence": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "level"
                    ]
                }
            }
        },
        "weaknessPriority": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "skillId": {
                        "type": "string"
                    },
                    "skillName": {
                        "type": "string"
                    },
                    "paper": {
                        "type": "string"
                    },
                    "priorityScore": {
                        "type": "number"
                    },
                    "recommendedAction": {
                        "type": "string"
                    }
                }
            }
        },
        "strengths": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "weaknesses": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "weekly_quest_plan": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "critical_areas": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "xp_earned": {
            "type": "integer"
        }
    },
    "required": [
        "version",
        "timestamp",
        "overall_level",
        "microSkills"
    ]
}