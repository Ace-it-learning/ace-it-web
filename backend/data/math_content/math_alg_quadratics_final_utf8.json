  {
    "level": 4,
    "topic": "Nature of Roots",
    "question": "The equation $x^2 + kx + 9 = 0$ has equal real roots. Find the possible values of $k$.",
    "question_zh": "\u65b9\u7a0b $x^2 + kx + 9 = 0$ \u6709\u7b49\u5be6\u6839\u3002\u6c42 $k$ \u7684\u53ef\u80fd\u503c\u3002",
    "answer": "k = 6 or k = -6",
    "answer_zh": "k = 6 \u6216 k = -6",
    "steps": [
      "For equal roots, $\\Delta = 0$.",
      "$k^2 - 4(1)(9) = 0$.",
      "$k^2 - 36 = 0 \\Rightarrow k^2 = 36$.",
      "$k = 6$ or $k = -6$."
    ],
    "steps_zh": [
      "\u5c0d\u65bc\u7b49\u5be6\u6839\uff0c$\\Delta = 0$\u3002",
      "$k^2 - 4(1)(9) = 0$\u3002",
      "$k^2 - 36 = 0 \\Rightarrow k^2 = 36$\u3002",
      "$k = 6$ \u6216 $k = -6$\u3002"
    ]
  },
