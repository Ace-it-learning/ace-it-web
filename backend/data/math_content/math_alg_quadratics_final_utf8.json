    "answer_zh": "\u9577 = 8 cm\uff0c\u5bec = 5 cm",
    "steps": [
      "Let width be $w$, then length is $w + 3$.",
      "Area $= w(w + 3) = 40$.",
      "$w^2 + 3w - 40 = 0$.",
      "Factorize: $(w + 8)(w - 5) = 0 \\Rightarrow w = 5$ ($w > 0$).",
      "Width $= 5$ cm, Length $= 5 + 3 = 8$ cm."
    ],
    "steps_zh": [
      "\u8a2d\u5bec\u70ba $w$\uff0c\u5247\u9577\u70ba $w + 3$\u3002",
      "\u9762\u7a4d $= w(w + 3) = 40$\u3002",
      "$w^2 + 3w - 40 = 0$\u3002",
      "\u56e0\u5f0f\u5206\u89e3\uff1a$(w + 8)(w - 5) = 0 \\Rightarrow w = 5$ (\u53d6\u6b63\u503c)\u3002",
      "\u5bec\u70ba 5 cm\uff0c\u9577\u70ba $5 + 3 = 8$ cm\u3002"
    ]
  },
