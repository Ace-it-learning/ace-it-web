    "subject": "maths",
    "level": 3,
    "type": "short_answer",
    "marks": 2,
    "question_en": "The stem-and-leaf diagram below shows the heights (cm) of 12 plants. Find the range of the heights. \\[ \\begin{array}{r|l} \\text{Stem (10)} & \\text{Leaf (1)} \\\\ \\hline 10 & 2, 5, 5 \\\\ 11 & 0, 3, 7, 8 \\\\ 12 & 1, 4, 6, 9 \\\\ 13 & 2 \\end{array} \\]",
    "question_zh": "下表顯示 12 株植物的高度 (cm)。求高度的全距。 \\[ \\begin{array}{r|l} \\text{莖 (10)} & \\text{葉 (1)} \\\\ \\hline 10 & 2, 5, 5 \\\\ 11 & 0, 3, 7, 8 \\\\ 12 & 1, 4, 6, 9 \\\\ 13 & 2 \\end{array} \\]",
    "answer": "30 cm",
    "correct_answer": "30",
    "solution_steps_en": [
      "1. Maximum value = 132 cm.",
      "2. Minimum value = 102 cm.",
      "3. Range = Max - Min = \\( 132 - 102 = 30 \\) cm."
    ],
    "solution_steps_zh": [
      "1. 最大值 = 132 cm。",
      "2. 最小值 = 102 cm。",
      "3. 全距 = \\( 132 - 102 = 30 \\) cm。"
    ],
    "diagram_json": null
  },
