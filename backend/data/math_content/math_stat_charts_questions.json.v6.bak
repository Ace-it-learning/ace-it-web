  {
    "id": "stat_01",
    "topic_id": "math_stat_charts",
    "subject": "maths",
    "level": 3,
    "type": "short_answer",
    "marks": 2,
    "question_en": "The stem-and-leaf diagram below shows the scores of 15 students in a test. Find the median of the scores. \\[ \\begin{array}{r|l} \\text{Stem (10)} & \\text{Leaf (1)} \\\\ \\hline 4 & 2, 5, 8 \\\\ 5 & 0, 3, 3, 6, 9 \\\\ 6 & 1, 4, 4, 7, 8 \\\\ 7 & 2, 5 \\end{array} \\]",
    "question_zh": "下表顯示 15 名學生在測驗中的得分。求得分的中位數。 \\[ \\begin{array}{r|l} \\text{莖 (10)} & \\text{葉 (1)} \\\\ \\hline 4 & 2, 5, 8 \\\\ 5 & 0, 3, 3, 6, 9 \\\\ 6 & 1, 4, 4, 7, 8 \\\\ 7 & 2, 5 \\end{array} \\]",
    "answer": "59",
    "correct_answer": "59",
    "solution_steps_en": [
      "1. Total number of students \\( n = 15 \\).",
      "2. The median is the 8th value (\\( (15+1)/2 = 8 \\)).",
      "3. Order: (42, 45, 48, 50, 53, 53, 56, 59). The 8th value is 59.",
      "4. Median = 59."
    ],
    "solution_steps_zh": [
      "1. 學生總數 \\( n = 15 \\)。",
      "2. 中位數是第 8 個數據 (\\( (15+1)/2 = 8 \\))。",
      "3. 有序數據：(42, 45, 48, 50, 53, 53, 56, 59)。第 8 個數據是 59。",
      "4. 中位數 = 59。"
    ],
    "diagram_json": null
  },
