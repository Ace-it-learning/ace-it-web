        { "type": "line", "x1": 170, "y1": 180, "x2": 225, "y2": 50, "stroke": "#a78bfa", "strokeWidth": 1.5, "strokeDasharray": "4,4" },
        { "type": "line", "x1": 225, "y1": 205, "x2": 225, "y2": 50, "stroke": "#dc2626", "strokeWidth": 2, "strokeDasharray": "5,5" },
