        { "type": "line", "x1": 240, "y1": 130, "x2": 200, "y2": 10, "stroke": "#94a3b8", "strokeDasharray": "3,3" },
        { "type": "line", "x1": 200, "y1": 10, "x2": 200, "y2": 250, "stroke": "#ef4444", "strokeDasharray": "1,1", "label": "h=12" },
