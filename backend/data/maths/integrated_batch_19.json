  {
    "id": "ct_mcq_281",
    "type": "mcq",
    "topic_id": "integrated_challenge",
    "prerequisite_topics": ["math_alg_polynomials"],
    "marks": 1,
    "difficulty": 5,
    "paper": 2,
    "section": "A",
    "question_en": "Find the quotient when $3x^3 - 5x^2 + 2x - 7$ is divided by $x - 2$.",
    "question_zh": "當 $3x^3 - 5x^2 + 2x - 7$ 除以 $x - 2$ 時，求商式。",
    "options": [
      "A. $3x^2 + x + 4$",
      "B. $3x^2 - x + 4$",
      "C. $3x^2 + x - 4$",
      "D. $3x^2 - x - 4$"
    ],
    "correct_answer": "A",
    "solution_steps_en": [
      "Using long division or synthetic division:",
      "Multiply $x-2$ by $3x^2$ to get $3x^3 - 6x^2$. Subtract to get $x^2 + 2x - 7$.",
      "Multiply $x-2$ by $x$ to get $x^2 - 2x$. Subtract to get $4x - 7$.",
      "Multiply $x-2$ by $4$ to get $4x - 8$. Subtract to get remainder 1.",
      "Quotient: $3x^2 + x + 4$."
    ],
    "solution_steps_zh": [
      "使用長除法或綜合除法：",
      "$(3x^3 - 5x^2 + 2x - 7) \\div (x-2)$：",
      "第一項為 $3x^2$，餘下 $x^2 + 2x - 7$。",
      "第二項為 $x$，餘下 $4x - 7$。",
      "第三項為 $4$，餘數為 1。",
      "商式：$3x^2 + x + 4$。"
    ],
    "diagram_json": null,
    "tags": ["polynomial-division", "algebra"],
    "status": "approved"
  },
  {
