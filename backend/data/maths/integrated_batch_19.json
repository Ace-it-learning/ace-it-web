        { "type": "line", "x1": 80, "y1": 50, "x2": 80, "y2": 280, "stroke": "#94a3b8", "label": "y" },
        { "type": "polyline", "points": [{"x": 120, "y": 210}, {"x": 300, "y": 210}, {"x": 210, "y": 100}, {"x": 120, "y": 210}], "stroke": "#7c3aed", "fill": "rgba(124, 58, 237, 0.2)" },
