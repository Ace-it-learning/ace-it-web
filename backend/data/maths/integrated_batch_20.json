  {
    "id": "ct_mcq_291",
    "type": "mcq",
    "topic_id": "integrated_challenge",
    "prerequisite_topics": ["math_alg_polynomials"],
    "marks": 1,
    "difficulty": 5,
    "paper": 2,
    "section": "A",
    "question_en": "If $\\log 2 = a$ and $\\log 3 = b$, express $\\log 18$ in terms of $a$ and $b$.",
    "question_zh": "若 $\\log 2 = a$ 及 $\\log 3 = b$，以 $a$ 及 $b$ 表示 $\\log 18$。",
    "options": [
      "A. $a + 2b$",
      "B. $2a + b$",
      "C. $a + b^2$",
      "D. $a^2b$"
    ],
    "correct_answer": "A",
    "solution_steps_en": [
      "$\\log 18 = \\log(2 \\times 3^2)$",
      "Using properties: $\\log(MN) = \\log M + \\log N$ and $\\log M^k = k \\log M$",
      "$\\log 18 = \\log 2 + \\log 3^2 = \\log 2 + 2 \\log 3$",
      "Substituting: $a + 2b$."
    ],
    "solution_steps_zh": [
      "$\\log 18 = \\log(2 \\times 3^2)$",
      "使用性質：$\\log(MN) = \\log M + \\log N$ 及 $\\log M^k = k \\log M$",
      "$\\log 18 = \\log 2 + \\log 3^2 = \\log 2 + 2 \\log 3$",
      "代入：$a + 2b$。"
    ],
    "diagram_json": null,
    "tags": ["logarithms", "properties"],
    "status": "approved"
  },
  {
    "id": "ct_mcq_292",
    "type": "mcq",
    "topic_id": "integrated_challenge",
    "prerequisite_topics": ["math_trig_applications"],
    "marks": 1,
    "difficulty": 5,
    "paper": 2,
    "section": "A",
    "question_en": "Simplify $\\frac{\\sin^2 \\theta + \\cos^2 \\theta}{1 + \\tan^2 \\theta}$.",
    "question_zh": "簡化 $\\frac{\\sin^2 \\theta + \\cos^2 \\theta}{1 + \\tan^2 \\theta}$。",
    "options": [
      "A. $\\sin^2 \\theta$",
      "B. $\\cos^2 \\theta$",
      "C. $\\tan^2 \\theta$",
      "D. 1"
    ],
    "correct_answer": "B",
    "solution_steps_en": [
      "Numerator: $\\sin^2\\theta + \\cos^2\\theta = 1$.",
      "Denominator: Express $\\tan\\theta$ in terms of sine and cosine: $1 + \\tan^2\\theta = 1 + \\frac{\\sin^2\\theta}{\\cos^2\\theta}$.",
      "Combine the denominator into a single fraction: $\\frac{\\cos^2\\theta + \\sin^2\\theta}{\\cos^2\\theta} = \\frac{1}{\\cos^2\\theta}$.",
      "Expression $= \\frac{1}{1/\\cos^2\\theta} = \\cos^2\\theta$."
    ],
    "solution_steps_zh": [
      "分子：$\\sin^2\\theta + \\cos^2\\theta = 1$。",
      "分母：將 $\\tan\\theta$ 以正弦及餘弦表示：$1 + \\tan^2\\theta = 1 + \\frac{\\sin^2\\theta}{\\cos^2\\theta}$。",
      "將分母合併為單一分數：$\\frac{\\cos^2\\theta + \\sin^2\\theta}{\\cos^2\\theta} = \\frac{1}{\\cos^2\\theta}$。",
      "算式 $= \\frac{1}{1/\\cos^2\\theta} = \\cos^2\\theta$。"
    ],
    "diagram_json": null,
    "tags": ["trig-identities", "simplification"],
    "status": "approved"
  },
  {
    "id": "ct_mcq_293",
    "type": "mcq",
    "topic_id": "integrated_challenge",
    "prerequisite_topics": ["math_alg_equations"],
    "marks": 1,
    "difficulty": 6,
    "paper": 2,
    "section": "A",
    "question_en": "It is given that $z$ varies directly as $x$ and inversely as $y^2$. If $x$ increases by 20% and $y$ decreases by 20%, find the percentage change in $z$.",
    "question_zh": "已知 $z$ 隨 $x$ 正變且隨 $y^2$ 反變。若 $x$ 增加 20% 且 $y$ 減少 20%，求 $z$ 的百分變化。",
    "options": [
      "A. 增加 25%",
      "B. 增加 50%",
      "C. 增加 87.5%",
      "D. 減少 4%"
    ],
    "correct_answer": "C",
    "solution_steps_en": [
      "Let $z = \\frac{kx}{y^2}$.",
      "New $x' = 1.2x$ and new $y' = 0.8y$.",
      "New $z' = \\frac{k(1.2x)}{(0.8y)^2} = \\frac{1.2}{0.64} \\times \\frac{kx}{y^2} = 1.875z$.",
      "Change $= (1.875 - 1) \\times 100\\% = +87.5\\%$."
    ],
    "solution_steps_zh": [
      "設 $z = \\frac{kx}{y^2}$。",
      "新 $x' = 1.2x$，新 $y' = 0.8y$。",
      "新 $z' = \\frac{k(1.2x)}{(0.8y)^2} = \\frac{1.2}{0.64}z = 1.875z$。",
      "百分變化 $= (1.875 - 1) \\times 100\\% = 87.5\\%$ (增加)。"
    ],
    "diagram_json": null,
    "tags": ["variation", "percentage-change"],
    "status": "approved"
  },
  {
    "id": "ct_mcq_294",
    "type": "mcq",
    "topic_id": "integrated_challenge",
    "prerequisite_topics": ["math_stat_prob"],
    "marks": 1,
    "difficulty": 6,
    "paper": 2,
    "section": "A",
    "question_en": "A box contains 4 red balls and 6 black balls. If two balls are drawn one by one with replacement, find the probability that the balls drawn are of different colors.",
    "question_zh": "袋中有 4 個紅球及 6 個黑球。若先後隨機抽出兩個球且每次抽出後放回，求抽出的兩球顏色不同的概率。",
    "options": [
      "A. 0.24",
      "B. 0.48",
      "C. 0.52",
      "D. 0.60"
    ],
    "correct_answer": "B",
    "solution_steps_en": [
      "Possible cases for different colors: (Red, Black) or (Black, Red).",
      "$P(R, B) = \\frac{4}{10} \\times \\frac{6}{10} = 0.24$.",
      "$P(B, R) = \\frac{6}{10} \\times \\frac{4}{10} = 0.24$.",
      "Total Prob $= 0.24 + 0.24 = 0.48$."
    ],
    "solution_steps_zh": [
      "不同顏色的可能情況：(紅, 黑) 或 (黑, 紅)。",
      "$P(紅, 黑) = \\frac{4}{10} \\times \\frac{6}{10} = 0.24$。",
      "$P(黑, 紅) = \\frac{6}{10} \\times \\frac{4}{10} = 0.24$。",
      "總概率 $= 0.24 + 0.24 = 0.48$。"
    ],
    "diagram_json": null,
    "tags": ["probability", "multi-stage"],
    "status": "approved"
  },
