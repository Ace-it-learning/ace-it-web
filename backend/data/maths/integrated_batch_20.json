    "id": "ct_mcq_295",
    "type": "mcq",
    "topic_id": "integrated_challenge",
    "prerequisite_topics": ["math_geo_mensuration"],
    "marks": 1,
    "difficulty": 6,
    "paper": 2,
    "section": "A",
    "question_en": "A composite solid consists of a hemisphere with radius 6 cm on top of a cylinder with the same radius and height 10 cm. Find the total volume of the solid in terms of $\\pi$.",
    "question_zh": "一個組合立體由一個半徑為 6 cm 的半球放在一個半徑相同且高為 10 cm 的圓柱體上方組成。以 $\\pi$ 表示該立體的總體積。",
    "options": [
      "A. $360\\pi$ cm$^3$",
      "B. $432\\pi$ cm$^3$",
      "C. $504\\pi$ cm$^3$",
      "D. $648\\pi$ cm$^3$"
    ],
    "correct_answer": "C",
    "solution_steps_en": [
      "Volume of hemisphere $= \\frac{1}{2} \\times \\frac{4}{3} \\pi (6^3) = \\frac{2}{3} \\pi (216) = 144\\pi$.",
      "Volume of cylinder $= \\pi (6^2) (10) = 360\\pi$.",
      "Total Volume $= 144\\pi + 360\\pi = 504\\pi$."
    ],
    "solution_steps_zh": [
      "半球體積 $= \\frac{1}{2} \\times \\frac{4}{3} \\pi (6^3) = 144\\pi$。",
      "圓柱體積 $= \\pi (6^2) (10) = 360\\pi$。",
      "總體積 $= 144\\pi + 360\\pi = 504\\pi$。"
    ],
    "diagram_json": null,
    "tags": ["mensuration", "combined-solids"],
    "status": "approved"
  },
