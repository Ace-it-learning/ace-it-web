  {
    "id": "ct_mcq_304",
    "type": "mcq",
    "topic_id": "integrated_challenge",
    "prerequisite_topics": ["math_geo_mensuration"],
    "marks": 1,
    "difficulty": 5,
    "paper": 2,
    "section": "A",
    "question_en": "Two similar solid cones $X$ and $Y$ have volumes in the ratio $8:27$. If the surface area of cone $X$ is 16 cm$^2$, find the surface area of cone $Y$.",
    "question_zh": "兩個相似立體圓錐 $X$ 及 $Y$ 的體積比為 $8:27$。若圓錐 $X$ 的表面積為 16 cm$^2$，求圓錐 $Y$ 的表面積。",
    "options": [
      "A. 24 cm$^2$",
      "B. 36 cm$^2$",
      "C. 54 cm$^2$",
      "D. 81 cm$^2$"
    ],
    "correct_answer": "B",
    "solution_steps_en": [
      "Ratio of volumes $= \\ell^3 = 8/27$.",
      "Ratio of lengths $\\ell = \\sqrt[3]{8/27} = 2/3$.",
      "Ratio of surface areas $= \\ell^2 = (2/3)^2 = 4/9$.",
      "Area of $Y = 16 \\times (9/4) = 36$ cm$^2$."
    ],
    "solution_steps_zh": [
      "體積比 $= \\ell^3 = 8/27$。",
      "長度比 $\\ell = \\sqrt[3]{8/27} = 2/3$。",
      "表面積比 $= \\ell^2 = (2/3)^2 = 4/9$。",
      "圓錐 $Y$ 的面積 $= 16 \\times (9/4) = 36$ cm$^2$。"
    ],
    "diagram_json": null,
    "tags": ["mensuration", "similarity"],
    "status": "approved"
  },
