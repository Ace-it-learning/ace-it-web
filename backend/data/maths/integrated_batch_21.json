    "paper": 2,
    "section": "A",
    "question_en": "Simplify $\\frac{(2 \\times 10^3)^4}{4 \\times 10^{-2}}$ and express the result in scientific notation.",
    "question_zh": "簡化 $\\frac{(2 \\times 10^3)^4}{4 \\times 10^{-2}}$，並以科學記數法表示結果。",
    "options": [
      "A. $4 \\times 10^5$",
      "B. $4 \\times 10^{13}$",
      "C. $4 \\times 10^{14}$",
      "D. $16 \\times 10^{14}$"
    ],
    "correct_answer": "C",
    "solution_steps_en": [
      "Numerator: $(2 \\times 10^3)^4 = 2^4 \\times (10^3)^4 = 16 \\times 10^{12}$.",
      "$\"Expression\" = \\frac{16 \\times 10^{12}}{4 \\times 10^{-2}}$.",
      "Divide coefficients: $16 / 4 = 4$.",
      "Divide powers of 10: $10^{12} / 10^{-2} = 10^{12 - (-2)} = 10^{14}$.",
      "Final Result: $4 \\times 10^{14}$."
    ],
    "solution_steps_zh": [
      "分子：$(2 \\times 10^3)^4 = 2^4 \\times (10^3)^4 = 16 \\times 10^{12}$。",
      "\"原式\" $= \\frac{16 \\times 10^{12}}{4 \\times 10^{-2}}$。",
      "常數相除：$16 / 4 = 4$。",
      "10 的冪相除：$10^{12} / 10^{-2} = 10^{14}$。",
      "最終結果：$4 \\times 10^{14}$。"
    ],
    "diagram_json": null,
    "tags": ["numbers", "scientific-notation"],
    "status": "approved"
  },
