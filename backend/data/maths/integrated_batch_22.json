    "id": "ct_mcq_314",
    "type": "mcq",
    "topic_id": "integrated_challenge",
    "prerequisite_topics": ["math_geo_circles"],
    "marks": 1,
    "difficulty": 5,
    "paper": 2,
    "section": "A",
    "question_en": "In the figure, $ABCD$ is a square and $E$ is the midpoint of $CD$. Find the ratio of the area of $\\triangle ADE$ to the area of square $ABCD$.",
    "question_zh": "圖中，$ABCD$ 為正方形，$E$ 為 $CD$ 的中點。求 $\\triangle ADE$ 面積與正方形 $ABCD$ 面積之比。",
    "options": [
      "A. $1:2$",
      "B. $1:4$",
      "C. $1:8$",
      "D. $2:3$"
    ],
    "correct_answer": "B",
    "solution_steps_en": [
      "Let the side length of square $ABCD$ be $s$.",
      "Area of square $ABCD = s^2$.",
      "In $\\triangle ADE$, base $DE = s/2$ and height $AD = s$.",
      "Area of $\\triangle ADE = \\frac{1}{2} \\times \\text{base} \\times \\text{height} = \\frac{1}{2} \\times \\frac{s}{2} \\times s = \\frac{s^2}{4}$.",
      "Ratio $= \\frac{s^2/4}{s^2} = 1:4$."
    ],
    "solution_steps_zh": [
      "設正方形的邊長為 $s$。",
      "正方形面積 $= s^2$。",
      "在 $\\triangle ADE$ 中，底 $DE = s/2$，高 $AD = s$。",
      "三角形面積 $= \\frac{1}{2} \\times \\frac{s}{2} \\times s = s^2/4$。",
      "面積比 $= 1:4$。"
    ],
