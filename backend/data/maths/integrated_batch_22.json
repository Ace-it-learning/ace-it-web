[
  {
    "id": "ct_mcq_311",
    "type": "mcq",
    "topic_id": "integrated_challenge",
    "prerequisite_topics": ["math_alg_polynomials"],
    "marks": 1,
    "difficulty": 5,
    "paper": 2,
    "section": "A",
    "question_en": "Mrs. Chan deposits $50,000 in a bank at an interest rate of 4% per annum, compounded semi-annually. Find the interest she will receive after 3 years, correct to the nearest dollar.",
    "question_zh": "陳太太將 $50,000 存入銀行，年利率為 4%，每半年結算利息一次。求 3 年後她所得的利息（準確至最接近的整數）。",
    "options": [
      "A. $6,000",
      "B. $6,243",
      "C. $6,308",
      "D. $56,308"
    ],
    "correct_answer": "C",
    "solution_steps_en": [
      "Principal $P = 50,000$. Rate per period $i = 4\\% / 2 = 2\\% = 0.02$.",
      "Number of periods $n = 3 \\times 2 = 6$.",
      "Amount $A = P(1 + i)^n = 50,000(1.02)^6 \\approx 56,308.12$.",
      "Interest $= A - P = 56,308.12 - 50,000 = 6,308.12$.",
      "Nearest dollar: $6,308$."
    ],
    "solution_steps_zh": [
      "本金 $P = 50,000$。每期利率 $i = 4\\% / 2 = 2\\% = 0.02$。",
      "期數 $n = 3 \\times 2 = 6$。",
      "本利和 $A = P(1 + i)^n = 50,000(1.02)^6 \\approx 56,308.12$。",
      "利息 $= A - P = 6,308.12$。",
      "最接近整數：$6,308$。"
    ],
    "diagram_json": null,
    "tags": ["compound-interest", "financial-math"],
    "status": "approved"
  },
  {
    "id": "ct_mcq_312",
    "type": "mcq",
    "topic_id": "integrated_challenge",
    "prerequisite_topics": ["math_alg_equations"],
    "marks": 1,
    "difficulty": 5,
    "paper": 2,
    "section": "A",
    "question_en": "It is given that $y - 2$ varies inversely as $x^3$. When $x = 2$, $y = 3$. Find $y$ when $x = 1$.",
    "question_zh": "已知 $y - 2$ 隨 $x^3$ 反變。當 $x = 2$ 時，$y = 3$。求當 $x = 1$ 時 $y$ 的值。",
    "options": [
      "A. 6",
      "B. 8",
      "C. 10",
      "D. 12"
    ],
    "correct_answer": "C",
    "solution_steps_en": [
      "Let $y - 2 = \\frac{k}{x^3}$.",
      "Substitute $x=2, y=3$: $3 - 2 = \\frac{k}{2^3} \\Rightarrow 1 = \\frac{k}{8} \\Rightarrow k = 8$.",
      "When $x = 1$: $y - 2 = \\frac{8}{1^3} = 8$.",
      "Thus $y = 8 + 2 = 10$."
    ],
    "solution_steps_zh": [
      "設 $y - 2 = \\frac{k}{x^3}$。",
      "代入 $x=2, y=3$：$3 - 2 = \\frac{k}{2^3} \\Rightarrow 1 = \\frac{k}{8} \\Rightarrow k = 8$。",
      "當 $x = 1$ 時：$y - 2 = \\frac{8}{1^3} = 8$。",
      "故 $y = 10$。"
    ],
    "diagram_json": null,
    "tags": ["variation", "inverse-variation"],
    "status": "approved"
  },
