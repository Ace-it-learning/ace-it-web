[
  {
    "id": "ct_mcq_321",
    "type": "mcq",
    "topic_id": "integrated_challenge",
    "prerequisite_topics": ["math_alg_polynomials"],
    "marks": 1,
    "difficulty": 5,
    "paper": 2,
    "section": "A",
    "question_en": "The value of a car depreciates by 15% each year. If its current value is $400,000, find its value after 4 years, correct to the nearest dollar.",
    "question_zh": "一輛汽車的價值每年折舊 15%。若其現值為 $400,000，求 4 年後的價值（準確至最接近的整數）。",
    "options": [
      "A. $160,000",
      "B. $208,803",
      "C. $231,205",
      "D. $289,000"
    ],
    "correct_answer": "B",
    "solution_steps_en": [
      "Principal value $P = 400,000$. Rate $r = 15\\% = 0.15$. Time $n = 4$.",
      "Using depreciation formula: $V = P(1 - r)^n$.",
      " $V = 400,000(1 - 0.15)^4 = 400,000(0.85)^4$.",
      " $V = 400,000(0.52200625) = 208,802.5$.",
      "Correct to the nearest dollar: $208,803$."
    ],
    "solution_steps_zh": [
      "現值 $P = 400,000$。折舊率 $r = 15\\% = 0.15$。時間 $n = 4$。",
      "使用折舊公式：$V = P(1 - r)^n$。",
      " $V = 400,000(0.85)^4 = 400,000(0.52200625) = 208,802.5$。",
      "準確至最接近的整數：$208,803$。"
    ],
    "diagram_json": null,
    "tags": ["growth-decay", "financial-math"],
    "status": "approved"
  },
  {
    "id": "ct_mcq_322",
    "type": "mcq",
    "topic_id": "integrated_challenge",
    "prerequisite_topics": ["math_alg_polynomials"],
    "marks": 1,
    "difficulty": 5,
    "paper": 2,
    "section": "A",
    "question_en": "Simplify $\\frac{x^2 - 4}{x^2 - x - 2} \\times \\frac{x+1}{x}$.",
    "question_zh": "簡化 $\\frac{x^2 - 4}{x^2 - x - 2} \\times \\frac{x+1}{x}$。",
    "options": [
      "A. $\\frac{x+2}{x}$",
      "B. $\\frac{x-2}{x}$",
      "C. $\\frac{x}{x+2}$",
      "D. $\\frac{x+2}{x+1}$"
    ],
    "correct_answer": "A",
    "solution_steps_en": [
      "Factorize the expressions:",
      " $x^2 - 4 = (x-2)(x+2)$.",
      " $x^2 - x - 2 = (x-2)(x+1)$.",
      "Substitute back: $\\frac{(x-2)(x+2)}{(x-2)(x+1)} \\times \\frac{x+1}{x}$.",
      "Cancel common terms $(x-2)$ and $(x+1)$.",
      "Result $= \\frac{x+2}{x}$."
    ],
    "solution_steps_zh": [
      "因式分解算式：",
      " $x^2 - 4 = (x-2)(x+2)$。",
      " $x^2 - x - 2 = (x-2)(x+1)$。",
      "代入：$\\frac{(x-2)(x+2)}{(x-2)(x+1)} \\times \\frac{x+1}{x}$。",
      "消去共同項 $(x-2)$ 及 $(x+1)$。",
      "結果 $= \\frac{x+2}{x}$。"
    ],
    "diagram_json": null,
    "tags": ["algebraic-fractions", "factorization"],
    "status": "approved"
  },
