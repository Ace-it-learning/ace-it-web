    "id": "ct_mcq_334",
    "type": "mcq",
    "topic_id": "integrated_challenge",
    "prerequisite_topics": ["math_alg_quadratics"],
    "marks": 1,
    "difficulty": 6,
    "paper": 2,
    "section": "A",
    "question_en": "If the length of a rectangle is increased by 20% and its width is decreased by 20%, what is the percentage change in its area?",
    "question_zh": "若長方形的長度增加 20% 而闊度減少 20%，求其面積的百分變化。",
    "options": [
      "A. No change",
      "B. Increased by 4%",
      "C. Decreased by 4%",
      "D. Decreased by 40%"
    ],
    "correct_answer": "C",
    "solution_steps_en": [
      "Let original length be $L$ and width be $W$. Original Area $A_1 = LW$.",
      "New length $L' = 1.2L$. New width $W' = 0.8W$.",
      "New Area $A_2 = (1.2L)(0.8W) = 0.96LW$.",
      "Percentage change $= \\frac{0.96LW - LW}{LW} \\times 100\\% = -4\\%$.",
      "The area is decreased by 4%."
    ],
    "solution_steps_zh": [
      "設原長度為 $L$，原闊度為 $W$。原面積 $A_1 = LW$。",
      "新長度 $L' = 1.2L$，新闊度 $W' = 0.8W$。",
      "新面積 $A_2 = (1.2)(0.8)LW = 0.96LW$。",
      "百分變化 $= (0.96 - 1) \\times 100\\% = -4\\%$。",
      "即減少了 4%。"
    ],
    "diagram_json": null,
    "tags": ["percentages", "geometry"],
    "status": "approved"
  },
