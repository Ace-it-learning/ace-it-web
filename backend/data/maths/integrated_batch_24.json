  {
    "id": "ct_mcq_331",
    "type": "mcq",
    "topic_id": "integrated_challenge",
    "prerequisite_topics": ["math_alg_variations"],
    "marks": 1,
    "difficulty": 5,
    "paper": 2,
    "section": "A",
    "question_en": "It is given that $z$ varies directly as $x^2$ and inversely as $y$. When $x = 2$ and $y = 3$, $z = 8$. Find the value of $z$ when $x = 3$ and $y = 6$.",
    "question_zh": "已知 $z$ 隨 $x^2$ 正變且隨 $y$ 反變。當 $x = 2$ 及 $y = 3$ 時，$z = 8$。求當 $x = 3$ 及 $y = 6$ 時 $z$ 的值。",
    "options": [
      "A. 4",
      "B. 9",
      "C. 12",
      "D. 18"
    ],
    "correct_answer": "B",
    "solution_steps_en": [
      "Variation equation: $z = \\frac{kx^2}{y}$.",
      "Substitute $x=2, y=3, z=8$: $8 = \\frac{k(2^2)}{3} \\Rightarrow 8 = \\frac{4k}{3}$.",
      "Solve for $k$: $k = \\frac{8 \\times 3}{4} = 6$.",
      "Substitute $x=3, y=6$ into $z = \\frac{6x^2}{y}$:",
      " $z = \\frac{6(3^2)}{6} = 3^2 = 9$."
    ],
    "solution_steps_zh": [
      "變項方程：$z = \\frac{kx^2}{y}$。",
      "代入 $x=2, y=3, z=8$：$8 = \\frac{k(2^2)}{3} \\Rightarrow k = 6$。",
      "將 $x=3, y=6$ 代入 $z = \\frac{6x^2}{y}$：",
      " $z = \\frac{6(3^2)}{6} = 9$。"
    ],
    "diagram_json": null,
    "tags": ["variations", "algebra"],
    "status": "approved"
  },
