    "id": "ct_mcq_333",
    "type": "mcq",
    "topic_id": "integrated_challenge",
    "prerequisite_topics": ["math_alg_equations"],
    "marks": 1,
    "difficulty": 5,
    "paper": 2,
    "section": "A",
    "question_en": "Factorize $4x^2 - 12xy + 9y^2 - 4x + 6y$.",
    "question_zh": "因式分解 $4x^2 - 12xy + 9y^2 - 4x + 6y$。",
    "options": [
      "A. $(2x - 3y)(2x - 3y + 2)$",
      "B. $(2x - 3y)(2x - 3y - 2)$",
      "C. $(2x + 3y)(2x + 3y - 2)$",
      "D. $(2x - 3y)^2 - 2(2x - 3y)$"
    ],
    "correct_answer": "B",
    "solution_steps_en": [
      "Group the first three terms: $4x^2 - 12xy + 9y^2 = (2x - 3y)^2$.",
      "Factorize the last two terms: $-4x + 6y = -2(2x - 3y)$.",
      "Combine: $(2x - 3y)^2 - 2(2x - 3y)$.",
      "Take out common factor $(2x - 3y)$:",
      " $(2x - 3y)[(2x - 3y) - 2] = (2x - 3y)(2x - 3y - 2)$."
    ],
    "solution_steps_zh": [
      "首三項為完全平方：$4x^2 - 12xy + 9y^2 = (2x - 3y)^2$。",
      "提取後兩項的公因子：$-4x + 6y = -2(2x - 3y)$。",
      "合併：$(2x - 3y)^2 - 2(2x - 3y)$。",
      "提取 $(2x - 3y)$：",
      " $(2x - 3y)(2x - 3y - 2)$。"
    ],
    "diagram_json": null,
    "tags": ["algebra", "factorization"],
    "status": "approved"
  },
