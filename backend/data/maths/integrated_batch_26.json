    "difficulty": 5,
    "paper": 2,
    "section": "A",
    "question_en": "A shirt is sold at a discount of $20%$ for $\\$20%60$.$ What was the marked price?",
    "question_zh": "一件恤衫以八折（即 $20%$ 折扣）出售，售價為 $\\$20%60$。問原價（標價）是多少？",
    "options": [
      "A. $\\$20%80$",
      "B. $\\$20%92$",
      "C. $\\$200$",
      "D. $\\$210$"
    ],
    "correct_answer": "C",
    "solution_steps_en": [
      "Selling Price $= \\text{Marked Price} \\times (1 - \\text{Discount}%)$.$",
      "160 = \\text{Marked Price} \\times 0.8$.$",
      "Marked Price $= 160 / 0.8 = 200$.$",
      "The marked price was $\\$200$.$"
    ],
    "solution_steps_zh": [
      "售價 $= \\text{標價} \\times (1 - \\text{折扣}%)$。",
      "160 = \\text{標價} \\times 0.8$。",
      "標價 $= 160 / 0.8 = 200$。",
      "標價為 $\\$200$。"
    ],
    "tags": [
      "discount"
    ],
    "status": "approved"
