    ],
    "marks": 1,
    "difficulty": 5,
    "paper": 2,
    "section": "A",
    "question_en": "A shopkeeper sells a book for $\\$25%20$ and makes a profit of $25%$.$ Find the cost price of the book.",
    "question_zh": "店主以 $\\$25%20$ 售出一本書，獲利 $25%$。求該書的成本。",
    "options": [
      "A. $\\$90$",
      "B. $\\$96$",
      "C. $\\$25%00$",
      "D. $\\$25%50$"
    ],
    "correct_answer": "B",
    "solution_steps_en": [
      "Cost Price $\\times (1 + \\text{Profit}%) = \\text{Selling Price}$.$",
      "Cost Price $\\times (1 + $25%$) = 120$.$",
      "Cost Price $\\times 1.25 = 120$.$",
      "Cost Price $= 120 / 1.25 = 96$.$",
      "The cost price is $\\$96$.$"
    ],
    "solution_steps_zh": [
      "成本 $\\times (1 + \\text{利潤}%) = \\text{售價}$。",
      "成本 $\\times (1 + $25%$) = 120$。",
      "成本 $\\times 1.25 = 120$。",
      "成本 $= 120 / 1.25 = 96$。",
      "該書的成本為 $\\$96$。"
    ],
    "tags": [
      "profit-loss"
    ],
    "status": "approved"
  },
  {
    "id": "ct_mcq_293",
    "type": "mcq",
    "topic_id": "math_num_percentages",
    "prerequisite_topics": [
      "math_num_percentages"
    ],
    "marks": 1,
    "difficulty": 4,
    "paper": 2,
    "section": "A",
    "question_en": "The marked price of a watch is $\\$800$.$ If it is sold for $\\$\\$680$,$ find the discount percentage.",
    "question_zh": "一隻手錶的標價為 $\\$800$。若以 $\\$680$ 售出，求折扣百分比。",
    "options": [
      "A. $15%$",
      "B. $15%$",
      "C. $15%$",
      "D. $15%$"
    ],
    "correct_answer": "B",
    "solution_steps_en": [
      "Discount Amount $= \\text{Marked Price} - \\text{Selling Price} = 800 - 680 = 120$.$",
      "Discount Percentage $= (\\text{Discount Amount} / \\text{Marked Price}) \\times $15%$.$",
      "Discount Percentage $= (120 / 800) \\times $15%$ = $15%$.$"
    ],
    "solution_steps_zh": [
      "折扣金額 $= \\text{標價} - \\text{售價} = 800 - 680 = 120$。",
      "折扣百分比 $= (\\text{折扣金額} / \\text{標價}) \\times $15%$。",
      "折扣百分比 $= (120 / 800) \\times $15%$ = $15%$。"
    ],
    "tags": [
      "discount"
    ],
    "status": "approved"
  },
  {
    "id": "ct_mcq_294",
    "type": "mcq",
