    "section": "A",
    "question_en": "A car is bought for $\\$200,000$.$ Its value depreciates by $15%$ in the first year and $10%$ in each subsequent year. Find its value after 2 years.",
    "question_zh": "以 $\\$200,000$ 購入一輛汽車。其價值在第一年貶值 $15%$，隨後每年貶值 $10%$。求該車在兩年後的價值。",
    "options": [
      "A. $\\$15%50,000$",
      "B. $\\$15%53,000$",
      "C. $\\$15%60,000$",
      "D. $\\$15%70,000$"
    ],
    "correct_answer": "B",
    "solution_steps_en": [
      "Value after 1st year $= 200,000 \\times (1 - $15%$) = 170,000$.$",
      "Value after 2nd year $= 170,000 \\times (1 - $15%$) = 153,000$.$"
    ],
    "solution_steps_zh": [
      "第一年後價值 $= 200,000 \\times 0.85 = 170,000$。",
      "第二年後價值 $= 170,000 \\times 0.9 = 153,000$。"
    ],
    "tags": [
      "depreciation"
    ],
    "status": "approved"
