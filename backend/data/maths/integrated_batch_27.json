    "paper": 2,
    "section": "A",
    "question_en": "Find the simple interest on $\\$5000$ at a rate of $6%$ per annum for $3$ years.",
    "question_zh": "求 $\\$5000$ 按年利率 $6%$ 計算 $3$ 年的單利息。",
    "options": [
      "A. $\\$300$",
      "B. $\\$600$",
      "C. $\\$900$",
      "D. $\\$6%200$"
    ],
    "correct_answer": "C",
    "solution_steps_en": [
      "Simple Interest $I = P \\times R \\times T$.$",
      "I = 5000 \\times $6%$ \\times 3$.$",
      "I = 5000 \\times 0.06 \\times 3 = 900$.$"
    ],
    "solution_steps_zh": [
      "單利息 $I = P \\times R \\times T$。",
      "I = 5000 \\times 0.06 \\times 3 = 900$。"
    ],
    "tags": [
      "simple-interest"
    ],
    "status": "approved"
  },
  {
    "id": "ct_mcq_302",
    "type": "mcq",
