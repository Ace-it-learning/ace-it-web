    "paper": 2,
    "section": "A",
    "question_en": "A sum of money is invested at $8%$ per annum compounded quarterly. Find the effective annual interest rate (correct to 2 decimal places).",
    "question_zh": "一筆款項按年利率 $8%$ 存放，每季計複利一次。求實際年利率（準確至二位小數）。",
    "options": [
      "A. $8%$",
      "B. $8%$",
      "C. $8%$",
      "D. $8%$"
    ],
    "correct_answer": "C",
    "solution_steps_en": [
      "Quarterly rate $= $8%$ / 4 = $8%$.$",
      "Effective Annual Rate $= (1 + $8%$)^4 - 1$.$",
      "Effective Annual Rate $= (1.02)^4 - 1 \\approx 1.08243 - 1 = 0.08243$.$",
      "Effective Annual Rate $\\approx $8%$.$"
    ],
    "solution_steps_zh": [
      "每季利率 $= $8%$ / 4 = $8%$。",
      "實際年利率 $= (1 + $8%$)^4 - 1$。",
      "實際年利率 $= (1.02)^4 - 1 \\approx $8%$。"
    ],
    "tags": [
      "compound-interest",
      "effective-rate"
    ],
    "status": "approved"
