    "marks": 1,
    "difficulty": 6,
    "paper": 2,
    "section": "A",
    "question_en": "A property is worth $\\$2,000,000$.$ The property tax rate is $15%$.$ If the allowance for repairs and outgoings is $20%$ of the property value, find the property tax payable.",
    "question_zh": "某物業價值為 $\\$2,000,000$。物業稅率為 $15%$。若修葺及支出免稅額為物業價值的 $20%$，求應繳付的物業稅。",
    "options": [
      "A. $\\$15%80,000$",
      "B. $\\$240,000$",
      "C. $\\$300,000$",
      "D. $\\$360,000$"
    ],
    "correct_answer": "B",
    "solution_steps_en": [
      "Net Rateable Value (or equivalent taxable amount) $= \\text{Value} \\times (1 - $15%$) = 2,000,000 \\times 0.8 = 1,600,000$.$",
      "Property Tax Payable $= 1,600,000 \\times $15%$ = 240,000$.$"
    ],
    "solution_steps_zh": [
      "扣除免稅額後的價值 $= 2,000,000 \\times 0.8 = 1,600,000$。",
      "物業稅 $= 1,600,000 \\times $15%$ = 240,000$。"
    ],
    "tags": [
      "taxation"
    ],
    "status": "approved"
  }
