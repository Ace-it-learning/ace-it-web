    ],
    "marks": 1,
    "difficulty": 6,
    "paper": 2,
    "section": "A",
    "question_en": "If $\\$2000$ is invested at a rate of $10%$ per annum compounded annually for $2$ years, find the interest earned.",
    "question_zh": "若以年利率 $10%$ 將 $\\$2000$ 存入銀行，按年計複利，求 $2$ 年後所得的利息。",
    "options": [
      "A. $\\$400$",
      "B. $\\$410$",
      "C. $\\$420$",
      "D. $\\$440$"
    ],
    "correct_answer": "B",
    "solution_steps_en": [
      "Amount $A = P(1 + R)^n$.$",
      "A = 2000(1 + $10%$)^2 = 2000(1.1)^2 = 2000(1.21) = 2420$.$",
      "Interest $= A - P = 2420 - 2000 = 410$.$"
    ],
    "solution_steps_zh": [
      "本利和 $A = P(1 + R)^n$。",
      "A = 2000(1 + 0.1)^2 = 2000(1.21) = 2420$。",
      "利息 $= A - P = 2420 - 2000 = 410$。"
    ],
    "tags": [
      "compound-interest"
    ],
    "status": "approved"
  },
  {
    "id": "ct_mcq_303",
    "type": "mcq",
