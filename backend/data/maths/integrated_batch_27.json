    "question_en": "If the annual salary of a person is $\\$\\text{HK$}300,000$ and the basic allowance is $\\$18%32,000$\\text{HK$},$ find the net chargeable income.",
    "question_zh": "若某人的年薪為 $\\$\\text{HK$}300,000$，基本免稅額為 $\\$18%32,000$，求其應課稅入息實額。",
    "options": [
      "A. $\\$18%32,000$",
      "B. $\\$18%68,000$",
      "C. $\\$\\text{HK$}300,000$",
      "D. $\\$\\text{HK$}432,000$"
    ],
    "correct_answer": "B",
    "solution_steps_en": [
      "Net Chargeable Income $= \\text{Total Income} - \\text{Allowances}$\\text{HK$}.$",
      "Net Chargeable Income $= 300,000 - 132,000 = 168,000$\\text{HK$}.$"
    ],
    "solution_steps_zh": [
      "應課稅入息實額 $= \\text{總入息} - \\text{免稅額}$。",
      "應課稅入息實額 $= 300,000 - 132,000 = 168,000$。"
    ],
    "tags": [
      "taxation"
    ],
