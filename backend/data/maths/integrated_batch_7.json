  {
    "id": "ct_mcq_169",
    "type": "mcq",
    "topic_id": "integrated_challenge",
    "prerequisite_topics": [
      "math_alg_polynomials",
      "math_alg_log_exp"
    ],
    "marks": 3,
    "difficulty": 7,
    "paper": 2,
    "section": "A",
    "question_en": "Find the number of real roots of the equation $\\log_{10}(x^2 - 3x + 2) = 0$.",
    "question_zh": "求方程 $\\log_{10}(x^2 - 3x + 2) = 0$ 的實根數目。",
    "options": [
      "A. 0",
      "B. 1",
      "C. 2",
      "D. Infinitely many"
    ],
    "correct_answer": "C",
    "solution_steps_en": [
      "$\\log_{10}(x^2 - 3x + 2) = 0 \\Rightarrow x^2 - 3x + 2 = 10^0 = 1$.",
      "$x^2 - 3x + 1 = 0$.",
      "Discriminant $\\Delta = (-3)^2 - 4(1)(1) = 9 - 4 = 5 > 0$.",
      "There are 2 distinct real roots.",
      "Check domain: $x^2 - 3x + 2$ must be $> 0$.",
      "When $x^2 - 3x + 2 = 1$, it is clearly $> 0$. Both roots are valid."
    ],
    "solution_steps_zh": [
      "$\\log_{10}(x^2 - 3x + 2) = 0 \\Rightarrow x^2 - 3x + 2 = 1$。",
      "$x^2 - 3x + 1 = 0$。",
      "判別式 $\\Delta = 9 - 4 = 5 > 0$。",
      "存在 2 個相異實根。",
      "檢查定義域：由於 $x^2 - 3x + 2 = 1 > 0$，兩根均有效。"
    ],
    "status": "approved"
  },
  {
    "id": "ct_mcq_170",
    "type": "mcq",
    "topic_id": "integrated_challenge",
    "prerequisite_topics": [
      "math_alg_variations",
      "math_alg_apgp"
    ],
    "marks": 3,
    "difficulty": 5,
    "paper": 2,
    "section": "A",
    "question_en": "The value of $y$ varies as $2^n$ where $n$ is a positive integer. If the first term $(n=1)$ is 6, find the 10th term $(n=10)$.",
    "question_zh": "已知 $y$ 隨 $2^n$ 而變，其中 $n$ 為正整數。若第一項 $(n=1)$ 為 6，求第 10 項 $(n=10)$。",
    "options": [
      "A. 1536",
      "B. 3072",
      "C. 6144",
      "D. 1024"
    ],
    "correct_answer": "B",
    "solution_steps_en": [
      "$y = k \\cdot 2^n$.",
      "When $n=1$, $y=6 \\Rightarrow 6 = k \\cdot 2^1 \\Rightarrow k = 3$.",
      "When $n=10$, $y = 3 \\cdot 2^{10} = 3 \\cdot 1024 = 3072$."
    ],
    "solution_steps_zh": [
      "$y = k \\cdot 2^n$。",
      "當 $n=1$，$y=6 \\Rightarrow 6 = 2k \\Rightarrow k = 3$。",
      "當 $n=10$，$y = 3 \\times 2^{10} = 3 \\times 1024 = 3072$。"
    ],
    "status": "approved"
  }
]
