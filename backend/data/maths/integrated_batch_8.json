  {
    "id": "ct_mcq_172",
    "type": "mcq",
    "topic_id": "integrated_challenge",
    "prerequisite_topics": [
      "math_stat_prob"
    ],
    "marks": 1,
    "difficulty": 4,
    "paper": 2,
    "section": "A",
    "question_en": "Three fair coins are tossed. Find the probability that at least one head is obtained.",
    "question_zh": "擲三枚均勻硬幣。求獲得最少一個硬幣正面的概率。",
    "options": [
      "A. 1/8",
      "B. 3/8",
      "C. 5/8",
      "D. 7/8"
    ],
    "correct_answer": "D",
    "solution_steps_en": [
      "Using the complement rule: $P(\\text{at least one head}) = 1 - P(\\text{no heads})$.",
      "$P(\\text{no heads}) = P(\\text{TTT}) = (1/2) \\times (1/2) \\times (1/2) = 1/8$.",
      "Probability $= 1 - 1/8 = 7/8$."
    ],
    "solution_steps_zh": [
      "使用餘概率：$P(\\text{最少一個正面}) = 1 - P(\\text{沒有正面})$。",
      "$P(\\text{沒有正面}) = P(TTT) = (1/2) \\times (1/2) \\times (1/2) = 1/8$。",
      "概率 $= 1 - 1/8 = 7/8$。"
    ],
    "status": "approved"
  },
