rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow users to read and write only their own progress data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      match /progress/{subject} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      match /chat_history/{msgId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      match /notebook/{nuggetId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /exam_state {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Past Papers (Public Read/Write for Authenticated Students during Migration)
    // Past Papers (Read-Only for students)
    match /past_papers/{paperId} {
      allow read: if request.auth != null;
      allow write: if false; // Admin only
      
      match /resources/{resId} {
        allow read: if request.auth != null;
        allow write: if false;
      }
      match /questions/{qId} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }

    // Mock Exams (The new standard)
    match /mock_exams/{examId} {
      allow read: if true;
      allow write: if false; // Admin only (backend)

      match /questions/{questionId} {
        allow read: if request.auth != null;
        allow write: if false;
      }

      // STRICTLY PRIVATE: Marking keys are for the backend (The Examiner/Critic) only.
      // Temporarily allowed for Developer Cheat Button
      match /marking_keys/{keyId} {
        allow read: if true; 
        allow write: if false; 
      }
    }
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
